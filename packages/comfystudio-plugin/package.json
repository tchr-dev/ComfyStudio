{
  "name": "@comfystudio/plugin",
  "version": "0.0.0",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rimraf lib && rimraf node_modules",
    "build:types": "tspc --project tsconfig.json",
    "build:javascript": "tsx scripts/Build.ts",
    "build": "yarn build:types && yarn build:javascript",
    "dev": "nodemon --watch src --ext ts,tsx,json --exec \"yarn build\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "nodemon": "^3.1.0",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "typescript-transform-paths": "^3.5.3"
  },
  "dependencies": {
    "zustand": "^4.5.2"
  }
}
