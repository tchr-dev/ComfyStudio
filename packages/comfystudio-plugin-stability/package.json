{
  "name": "@comfystudio/plugin-stability",
  "version": "0.0.0",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rimraf lib && rimraf api-interfaces && rimraf node_modules",
    "generate:proto": "tsx scripts/GenerateProto.ts",
    "build:types": "tspc --project tsconfig.json",
    "build:javascript": "tsx scripts/Build.ts",
    "build": "yarn build:types && yarn build:javascript",
    "dev": "nodemon --watch src --ext ts,json --exec \"yarn build\""
  },
  "dependencies": {
    "@protobuf-ts/grpcweb-transport": "^2.9.4",
    "@protobuf-ts/runtime": "^2.9.4",
    "@protobuf-ts/runtime-rpc": "^2.9.4"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.9.4",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "concurrently": "^8.2.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-markdown": "^3.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "nodemon": "^3.1.0",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "ts-proto": "^1.181.2",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "typescript-transform-paths": "^3.5.3"
  }
}
