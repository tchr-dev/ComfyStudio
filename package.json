{
  "license": "MIT",
  "packageManager": "yarn@3.3.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "postinstall": "husky || true",
    "prepare": "husky || true",
    "comfystudio-plugin": "yarn workspace @comfystudio/plugin",
    "comfystudio-plugin-example": "yarn workspace @comfystudio/plugin-example",
    "comfystudio-plugin-stability": "yarn workspace @comfystudio/plugin-stability",
    "comfystudio-plugin-webgpu": "yarn workspace @comfystudio/plugin-webgpu",
    "comfystudio-plugin-webui": "yarn workspace @comfystudio/plugin-webui",
    "comfystudio-plugin-comfyui": "yarn workspace @comfystudio/plugin-comfyui",
    "comfystudio-ui": "yarn workspace @comfystudio/ui",
    "dev:use-example-plugin": "cross-env VITE_USE_EXAMPLE_PLUGIN=true yarn dev",
    "dev:use-webui-plugin": "cross-env VITE_USE_WEBUI_PLUGIN=true yarn dev",
    "dev:use-stability-plugin": "cross-env VITE_USE_STABILITY_PLUGIN=true yarn dev",
    "start": "./scripts/start-all.sh",
    "dev": "yarn workspaces foreach --all --interlaced --verbose --parallel --jobs unlimited run dev",
    "build": "yarn workspaces foreach --all --interlaced --verbose --jobs unlimited run build",
    "clean": "yarn workspaces foreach --all --interlaced --verbose --parallel --jobs unlimited run clean && rimraf node_modules"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "rimraf": "^5.0.7"
  },
  "lint-staged": {
    "./packages/ui/**/*.{ts,tsx,js,jsx,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "resolutions": {
    "@types/react": "18.0.38",
    "@types/react-dom": "18.0.11"
  }
}
